 "scene_tones": {
  "_comment": "Pace of designed scenes (the same numbers as kit/scenes/tones.ts): entrance and exit in frames at 30 fps, hold after the last spoken word (s), entrance motion, default scene transition, overshoot (only if the brand tone allows it).",
  "calm": {
   "in": 14,
   "out": 9,
   "hold": 0.4,
   "enter": "rise 30 px + opacity, Easing.out(cubic)",
   "transition": "fade",
   "overshoot": false
  },
  "deadpan": {
   "in": 18,
   "out": 12,
   "hold": 0.6,
   "enter": "opacity only",
   "transition": "fade",
   "overshoot": false
  },
  "cinematic": {
   "in": 16,
   "out": 10,
   "hold": 0.5,
   "enter": "scale 0.95 -> 1 + opacity",
   "transition": "fade",
   "overshoot": false
  },
  "feature": {
   "in": 10,
   "out": 8,
   "hold": 0.4,
   "enter": "slide 60 px from the side",
   "transition": "slide",
   "overshoot": false
  },
  "punchy": {
   "in": 8,
   "out": 6,
   "hold": 0.3,
   "enter": "slam: scale 1.08 -> 1, spring damping 14 (200 when the brand tone allows no overshoot)",
   "transition": "cut",
   "overshoot": true
  },
  "hype": {
   "in": 5,
   "out": 4,
   "hold": 0.25,
   "enter": "zoom 1.2 -> 1, a 2-4 px shake for 6 frames (if shake is allowed)",
   "transition": "cut",
   "overshoot": true
  },
  "parody": {
   "in": 0,
   "out": 0,
   "hold": 0.5,
   "enter": "hard cut",
   "transition": "cut",
   "overshoot": false
  }
 },
