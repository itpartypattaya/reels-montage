# OS junk files (the plugin directory rejects them)
.DS_Store
Thumbs.db
desktop.ini
__MACOSX/

# Brand profiles live in your editing project (<project>/brands/), never in this repository
brands/

# Eval results: local, per run (tools/run_evals.py)
evals/results/

# Python and Node caches from running scripts or tests locally
__pycache__/
*.pyc
node_modules/
